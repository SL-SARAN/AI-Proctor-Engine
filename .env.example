# Use a least-privilege PostgreSQL account in non-development environments.
DATABASE_URL=postgresql+psycopg://proctoring:change-me@localhost:5432/proctoring
APP_ENV=development

# LTI 1.3 tool registration. Each platform (Canvas, Moodle, Blackboard)
# issues a client_id; register this tool there to obtain one.
LTI_TOOL_CLIENT_ID=proctoring-engine-dev

# This tool's launch callback URL. Must match the redirect_uri registered
# on the platform's LTI 1.3 tool record.
LTI_LAUNCH_URL=http://localhost:8000/lti/launch

# Discovery endpoint override (optional). If unset, the launch handler
# fetches {iss}/.well-known/openid-configuration from the platform.
LTI_OIDC_DISCOVERY_URL=
LTI_OIDC_JWKS_URL=

# LTI audience override. When set, the launch handler validates `aud` as
# this value instead of the tool_client_id. Some non-conformant platforms
# send the deployment_id in `aud` rather than the tool_client_id.
LTI_AUDIENCE_OVERRIDE=

# Session token. HS256-signed JWT used by the WebSocket layer (next
# atomic layer) for authentication. The secret MUST be at least 32 bytes
# of high-entropy material; rotate without downtime by writing a new
# secret and accepting tokens signed with either for a grace window.
SESSION_TOKEN_SECRET=replace-with-32-bytes-of-random-material-from-a-secret-manager
SESSION_TOKEN_TTL_SECONDS=14400
SESSION_TOKEN_ISSUER=proctoring-engine
SESSION_TOKEN_AUDIENCE=proctoring-client

# State / nonce store TTL. The window the platform has to complete an
# LTI 1.3 launch (login → callback) before the issued state/nonce is
# purged from the store. With ``LTI_STATE_STORE_BACKEND=redis`` the TTL
# is enforced by Redis' own ``SETEX``; with ``memory`` the in-process
# store evicts lazily on observation and explicitly via
# ``purge_expired``.
LTI_STATE_STORE_TTL_SECONDS=600

# Which launch-state backend the api tier uses. ``memory`` is the
# single-replica default; ``redis`` is required when scaling beyond
# one replica, since the OIDC ``state``/``nonce`` issued by one
# replica is invisible to the others (per docs/DEPLOYMENT.md §6.2).
LTI_STATE_STORE_BACKEND=memory

# Redis connection URL, only consulted when ``LTI_STATE_STORE_BACKEND=redis``.
# Examples:
#   redis://redis:6379/0                    (no auth, in-cluster)
#   redis://:password@host:6379/0          (with auth)
#   rediss://:password@host:6380/0         (TLS)
REDIS_URL=

# S3-compatible evidence storage. Cloudflare R2 in production
# (https://<accountid>.r2.cloudflarestorage.com); MinIO in local dev
# (http://minio:9000 / http://localhost:9000). The bucket name must be
# unique within the account; the engine will create it on startup if it
# does not already exist.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=proctoring
S3_SECRET_KEY=change-me
S3_BUCKET=proctoring-evidence
# R2 expects "auto"; MinIO expects "us-east-1".
S3_REGION=auto
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=30

# Internal terminate credential. The fusion engine attaches this as
# ``Authorization: Bearer <INTERNAL_TERMINATE_TOKEN>`` to the internal
# ``POST /sessions/{id}/terminate`` route. Distinct from any LTI-derived
# session token per docs/07-api-orchestration-design.md §3 (the single
# internal exception to the LTI-roles authorization model). The secret
# MUST be at least 32 bytes of high-entropy material; rotate without
# downtime by writing a new secret and accepting tokens signed with
# either for a grace window.
INTERNAL_TERMINATE_TOKEN=replace-with-32-bytes-of-random-material-from-a-secret-manager

# Retention horizon stamped onto ``EvidenceArtifact.retention_expires_at``
# when the seal request did not supply one explicitly.  Default: 90 days.
ORCHESTRATION_RETENTION_DEFAULT_SECONDS=7776000

